# Application
APP_NAME=Onboard Chaser AI
APP_VERSION=0.1.0
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/onboard_chaser

# Security
SECRET_KEY=change-me-to-a-random-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAGIC_TOKEN_EXPIRE_HOURS=72

# Cloudflare R2 (documents are encrypted-at-rest AES-256-Fernet before upload;
# the bucket MUST be configured as PRIVATE — access only via presigned URLs)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=onboard-chaser-documents
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
# Optional: dedicated key for document encryption (defaults to derived SECRET_KEY)
STORAGE_ENCRYPTION_KEY=

# Resend Email
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@onboardchaser.ai

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend
FRONTEND_URL=http://localhost:5173
